# ==========================================
# MERAGLYM PLATFORM CONFIGURATION (.env.example)
# ==========================================

# Environment
NODE_ENV=production
DEMO_MODE=false
LOG_LEVEL=info

# Cloudflare Edge Bindings & Database
DATABASE_URL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Job Engine
JOB_TIMEOUT_MS=30000
JOB_MAX_RETRIES=3
JOB_CONCURRENCY=5

# AI & LLM Engine
WORKERS_AI_ENABLED=true
AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# External Optional OSINT Credentials
FSSP_API_KEY=
SPIDERFOOT_SERVER_URL=
OPENCTI_URL=
OPENCTI_TOKEN=
TOR_SOCKS5_PROXY=socks5://127.0.0.1:9050
