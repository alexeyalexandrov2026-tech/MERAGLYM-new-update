{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meraglym",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meraglym-db",
      "database_id": "18e6b0bb-6be6-4b60-8a89-34b001531abc"
    }
  ]
}
