{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meraglym-consumer",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meraglym-db",
      "database_id": "18e6b0bb-6be6-4b60-8a89-34b001531abc"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "meraglym-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  }
}
