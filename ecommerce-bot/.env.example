# ---------------------------------------------------------------------------
# Copy to .env for local development. NEVER commit a real .env.
# In production, inject these from a secrets manager (AWS Secrets Manager,
# GCP Secret Manager, Vault, Fly secrets, Render environment groups) rather
# than from a file on disk.
#
# Every value marked <PLACEHOLDER> must be replaced before the app will start
# in production; app/config.py refuses to boot on a placeholder or empty secret.
# ---------------------------------------------------------------------------

# --- Core ---
ENVIRONMENT=development                 # development | test | production
LOG_LEVEL=INFO
LOG_FORMAT=json                         # json | console
PUBLIC_BASE_URL=http://localhost:8000   # must be https:// in production
STOREFRONT_SUCCESS_PATH=/checkout/success
STOREFRONT_CANCEL_PATH=/checkout/cancel

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://shopbot:shopbot@db:5432/shopbot
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Payments: Stripe -----------------------------------------------------
# PROVIDER-SPECIFIC CONFIGURATION REQUIRED.
# Test keys start sk_test_ / whsec_. The app refuses to run production on a
# test key. Get these from the Stripe Dashboard -> Developers -> API keys,
# and the webhook secret from Developers -> Webhooks -> your endpoint.
PAYMENT_PROVIDER=stripe                 # stripe | fake (fake = offline dev only)
STRIPE_API_KEY=<PLACEHOLDER:sk_test_...>
STRIPE_WEBHOOK_SECRET=<PLACEHOLDER:whsec_...>
STRIPE_API_VERSION=                     # optional: pin, e.g. 2024-06-20
CURRENCY=usd
CHECKOUT_SESSION_TTL_MINUTES=30
SHIPPING_FLAT_MINOR=500                 # 5.00 in minor units

# --- Receipts by email ----------------------------------------------------
# PROVIDER-SPECIFIC CONFIGURATION REQUIRED.
# Works with any SMTP submission endpoint (SES, Postmark, SendGrid, Mailgun,
# Resend, or your own MTA). The sending domain needs SPF, DKIM and DMARC.
EMAIL_BACKEND=console                   # console (dev) | smtp (production) | memory (tests)
EMAIL_FROM=receipts@example.com
EMAIL_FROM_NAME=Example Store
SMTP_HOST=<PLACEHOLDER:smtp.your-provider.com>
SMTP_PORT=587
SMTP_USERNAME=<PLACEHOLDER>
SMTP_PASSWORD=<PLACEHOLDER>
SMTP_STARTTLS=true

# --- Admin API ------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Minimum 32 characters in production.
ADMIN_API_KEY=<PLACEHOLDER:generate-a-long-random-string>

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_PER_MINUTE=120
RATE_LIMIT_CHECKOUT_PER_MINUTE=10
RATE_LIMIT_ADMIN_PER_MINUTE=60
# Set REDIS_URL once you run more than one web replica, otherwise each
# process enforces its own separate limit.
REDIS_URL=redis://redis:6379/0
# Number of trusted reverse proxies in front of this service. 0 = do not trust
# X-Forwarded-For at all. Set to 1 behind a single load balancer.
TRUSTED_PROXY_HOPS=0

# --- Worker ---------------------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_LOCK_SECONDS=120
WEBHOOK_RETRY_AFTER_SECONDS=300
